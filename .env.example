# L0 ablation branch: defaults to true, including with an existing private .env.
# Set false to restore the full hierarchy; consolidation then follows its own setting.
MEM_PLUGIN_L0_ONLY=true

# Service bind address; independent from the public agent URL below.
MEM_PLUGIN_HOST=127.0.0.1
MEM_PLUGIN_PORT=8000

# Agent connection URL; its path also selects the MCP HTTP endpoint.
MEM_PLUGIN_MCP_URL=http://127.0.0.1:8000/mcp

# Required bearer credential. Run scripts/init_env.py to generate a local secret.
# Never commit a real token here or put it in the URL.
MEM_PLUGIN_MCP_TOKEN=

# This shared credential is bound to a trusted identity and an explicit namespace allowlist.
MEM_PLUGIN_USER_ID=personal-user
MEM_PLUGIN_AGENT_ID=personal-agent
MEM_PLUGIN_NAMESPACES=default
MEM_PLUGIN_DOMAINS=

# PostgreSQL is the only storage backend. The initializer generates passwords and URLs.
POSTGRES_USER=mem_plugin
POSTGRES_DB=mem_plugin
POSTGRES_PASSWORD=
# Only the development Compose override publishes this loopback port.
MEM_PLUGIN_POSTGRES_PORT=55433
# scripts/init_env.py derives this host-side URL without printing credentials.
DATABASE_URL=
# Same database through the Compose service network; used by API/migration containers.
DATABASE_URL_DOCKER=

# Embedding uses its own credentials and endpoint; keys are never generated for external APIs.
EMBEDDING_PROVIDER=bailian
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSION=1024

# Active LLM provider: deepseek. Bailian settings remain available but are inactive.
LLM_PROVIDER=deepseek
DEEPSEEK_LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_API_KEY=
DEEPSEEK_LLM_MODEL=deepseek-flash
DEEPSEEK_LLM_TIMEOUT_SECONDS=90
DEEPSEEK_LLM_ENABLE_THINKING=false

# Beijing endpoint; kimi-k3 is served by Bailian using this configuration.
BAILIAN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_LLM_API_KEY=
BAILIAN_LLM_MODEL=kimi-k3
# 单次 HTTP 连接/读取等待上限；超时不会自动重复付费请求
BAILIAN_LLM_TIMEOUT_SECONDS=90
# kimi-k3 的有界 JSON 任务关闭思考；其他型号可留空以沿用服务默认
# 支持关闭思考的模型可用 false；glm-5.3 必须使用 true（不能沿用 false）
BAILIAN_LLM_ENABLE_THINKING=false
# 可留空沿用模型默认；glm-5.3 的记忆 JSON 任务可用 low 控制思考开销
BAILIAN_LLM_REASONING_EFFORT=

# Optional reranker: a native DashScope endpoint, separate from the embedding API.
RERANK_PROVIDER=bailian
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank

# Bounded admission and retrieval. Reranking is opt-in and may incur model charges.
MEM_PLUGIN_MAX_NOTE_CHARACTERS=16000
RETRIEVAL_CANDIDATE_LIMIT=50
RETRIEVAL_RRF_K=60
RETRIEVAL_TRIGRAM_THRESHOLD=0.2
RETRIEVAL_RERANK_ENABLED=false

# Worker runs separately; no model request occurs until it is explicitly started.
WORKER_LEASE_SECONDS=120
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=5

# L0 associations after embedding. One bounded LLM request per graph task with candidates.
GRAPH_ENABLED=true
GRAPH_CANDIDATE_LIMIT=5
GRAPH_MAX_DISTANCE=0.35
GRAPH_MIN_CONFIDENCE=0.75
GRAPH_MAX_INPUT_CHARACTERS=12000
# 思考模型的预算还包括 reasoning_tokens；glm-5.3 当前验证使用 4096
GRAPH_MAX_OUTPUT_TOKENS=1024

# Adjacent-level consolidation; unique L0 evidence is counted once across all paths.
CONSOLIDATION_ENABLED=false
CONSOLIDATION_L1_MIN_SOURCES=2
CONSOLIDATION_L2_MIN_SOURCES=2
CONSOLIDATION_L3_MIN_SOURCES=2
CONSOLIDATION_L1_MIN_EVIDENCE=2
CONSOLIDATION_L2_MIN_EVIDENCE=3
CONSOLIDATION_L3_MIN_EVIDENCE=5
# 仅限制发现新关联时的召回数，不是已有主题的容量上限
CONSOLIDATION_CANDIDATE_LIMIT=12
CONSOLIDATION_EVIDENCE_LIMIT=50
CONSOLIDATION_MAX_DISTANCE=0.45
CONSOLIDATION_MAX_GROUPS=3
CONSOLIDATION_MIN_CONFIDENCE=0.75
CONSOLIDATION_MAX_INPUT_CHARACTERS=24000
# glm-5.3 当前验证使用 4096；预算不足会明确失败，不发布截断摘要
CONSOLIDATION_MAX_OUTPUT_TOKENS=2048

# Scheduler enqueues tasks only; it never calls models.
SCHEDULER_L1_INTERVAL_SECONDS=3600
SCHEDULER_L2_INTERVAL_SECONDS=86400
SCHEDULER_L3_INTERVAL_SECONDS=604800
SCHEDULER_BATCH_SIZE=50

# Validity, confidence and retention are independent; defaults archive, never auto-delete.
LIFECYCLE_ENABLED=true
LIFECYCLE_INTERVAL_SECONDS=3600
LIFECYCLE_DECAY_INTERVAL_SECONDS=86400
LIFECYCLE_RESTORE_GRACE_DAYS=7
# Per-type JSON overrides; zero disables that age-based rule. See docs/memory-lifecycle.md.
LIFECYCLE_TYPE_POLICIES={}
# Host processes must share this directory; Compose overrides it with its shared archive volume.
ARCHIVE_DIR=data/archive
ARCHIVE_MAX_BYTES=8388608

# Private Agent test profiles; normal memory stays in its existing namespaces.
TEST_RUNS_DIR=data/test-runs
